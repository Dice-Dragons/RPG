{
    "template": "cv6_dice_macros",
    "description": "Uses setKey in dice_all_results and dice_result_display when Character DiceSet is set",
    "execution_order": 30,
    "enabled": true,
    "action": "str_replace",
    "find": "<xf:macro id=\"dice_all_results\" arg-roll=\"!\" arg-user=\"\">\n\t<xf:foreach loop=\"$roll\" key=\"$tag\" value=\"$die\">\n\t\t<xf:if is=\"$tag == 'info'\">\n\t\t\t{{ phrase('cv6_option_issue') }}\n\t\t<xf:else />\n\t\t\t<xf:if is=\"is_array($die) AND {$die.result|count} > 0\">\n\t\t\t\t<div class=\"bbCodeBlock--roll\">\n\t\t\t\t\t<xf:macro id=\"dice_result_display\" arg-die=\"{$die}\" arg-user=\"{$user}\" />\n\t\t\t\t</div>\n\t\t\t</xf:if>\n\t\t</xf:if>\n\t</xf:foreach>\n</xf:macro>\n\n<xf:macro id=\"dice_result_display\" arg-die=\"!\" arg-user=\"\">\n\t<xf:set var=\"$dieObj\" value=\"{$xf.allDice.{$die.tag}}\" />\n\t<xf:if is=\"$dieObj\">\n\t\t<xf:if is=\"{$dieObj.big}\">\n\t\t\t<xf:set var=\"$extra-class\" value=\" die--big\" />\n\t\t\t<xf:set var=\"$setClass\" value=\"\" />\n\t\t\t<xf:set var=\"$graphicUrl\" value=\"\" />\n\t\t<xf:else />\n\t\t\t<xf:set var=\"$extra-class\" value=\"\" />\n\t\t\t<xf:set var=\"$graphicUrl\" value=\"{{ $dieObj.getGraphicUrl($user) }}\" />\n\t\t\t<xf:if is=\"{$dieObj.graphic_type} == 'set'\">\n\t\t\t\t<xf:set var=\"$effectiveDefaultSet\" value=\"{{ property('cv6DefaultDiceSet') ?: ($xf.options.cv6DiceDefaultSet ?: 'default') }}\" />\n\t\t\t\t<xf:set var=\"$userSetKey\" value=\"{{ ($user && $user.Option && $user.Option.cv6_dice_set && $user.Option.cv6_dice_set != 'default') ? $user.Option.cv6_dice_set : $effectiveDefaultSet }}\" />",
    "replace": "<xf:macro id=\"dice_all_results\" arg-roll=\"!\" arg-user=\"\" arg-setKey=\"\">\n\t<xf:foreach loop=\"$roll\" key=\"$tag\" value=\"$die\">\n\t\t<xf:if is=\"$tag == 'info'\">\n\t\t\t{{ phrase('cv6_option_issue') }}\n\t\t<xf:else />\n\t\t\t<xf:if is=\"is_array($die) AND {$die.result|count} > 0\">\n\t\t\t\t<div class=\"bbCodeBlock--roll\">\n\t\t\t\t\t<xf:macro id=\"dice_result_display\" arg-die=\"{$die}\" arg-user=\"{$user}\" arg-setKey=\"{$setKey}\" />\n\t\t\t\t</div>\n\t\t\t</xf:if>\n\t\t</xf:if>\n\t</xf:foreach>\n</xf:macro>\n\n<xf:macro id=\"dice_result_display\" arg-die=\"!\" arg-user=\"\" arg-setKey=\"\">\n\t<xf:set var=\"$dieObj\" value=\"{$xf.allDice.{$die.tag}}\" />\n\t<xf:if is=\"$dieObj\">\n\t\t<xf:if is=\"{$dieObj.big}\">\n\t\t\t<xf:set var=\"$extra-class\" value=\" die--big\" />\n\t\t\t<xf:set var=\"$setClass\" value=\"\" />\n\t\t\t<xf:set var=\"$graphicUrl\" value=\"\" />\n\t\t<xf:else />\n\t\t\t<xf:set var=\"$extra-class\" value=\"\" />\n\t\t\t<xf:set var=\"$graphicUrl\" value=\"{{ $setKey ? $dieObj.getGraphicUrlForSetKey($setKey, $user) : $dieObj.getGraphicUrl($user) }}\" />\n\t\t\t<xf:if is=\"{$dieObj.graphic_type} == 'set'\">\n\t\t\t\t<xf:set var=\"$effectiveDefaultSet\" value=\"{{ property('cv6DefaultDiceSet') ?: ($xf.options.cv6DiceDefaultSet ?: 'default') }}\" />\n\t\t\t\t<xf:set var=\"$userSetKey\" value=\"{{ $setKey ?: (($user && $user.Option && $user.Option.cv6_dice_set && $user.Option.cv6_dice_set != 'default') ? $user.Option.cv6_dice_set : $effectiveDefaultSet) }}\" />"
}